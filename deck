#!/bin/zsh
# Start the agent-deck server (if needed) and open it as a standalone app window.
DIR="${0:A:h}"
PORT="${DECK_PORT:-7681}"
URL="http://localhost:$PORT"
mkdir -p ~/.agent-deck
# inside the packaged app, node sits next to the code
NODE="${DIR:h}/node"; [ -x "$NODE" ] || NODE=node
case "$1" in
  stop)
    # find the server by the port it listens on, however it was started
    PIDS=$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null)
    if [ -n "$PIDS" ]; then kill $PIDS; elif [ "$2" != "--all" ]; then echo "moontty was not running on :$PORT"; exit; fi
    if [ "$2" = "--all" ]; then
      pkill -f "dtach -A ${DECK_STATE:-$HOME/.agent-deck}/sock/"; rm -f "${DECK_STATE:-$HOME/.agent-deck}"/sock/*.sock
      echo "moontty stopped, every agent ended"
    else
      echo "moontty stopped; agents keep running and re-attach on next start (deck stop --all ends them)"
    fi
    exit ;;
  log)  tail -f ~/.agent-deck/server.log; exit ;;
  setup) "$NODE" "$DIR/setup.js"; exit ;;
esac
if ! curl -s -o /dev/null "$URL"; then
  nohup "$NODE" "$DIR/server.js" >> ~/.agent-deck/server.log 2>&1 &
  for i in {1..30}; do curl -s -o /dev/null "$URL" && break; sleep 0.2; done
fi
if [ -d "/Applications/Moontty.app" ]; then open -a "Moontty"; else open -na "Google Chrome" --args --app="$URL" --window-size=1500,950; fi
