#!/bin/zsh
# Start the agent-deck server (if needed) and open it as a standalone app window.
DIR="${0:A:h}"
PORT="${DECK_PORT:-7681}"
URL="http://localhost:$PORT"
mkdir -p ~/.agent-deck
case "$1" in
  stop) pkill -f "node $DIR/server.js" && echo "agent-deck stopped (all agents killed)"; exit ;;
  log)  tail -f ~/.agent-deck/server.log; exit ;;
esac
if ! curl -s -o /dev/null "$URL"; then
  nohup node "$DIR/server.js" >> ~/.agent-deck/server.log 2>&1 &
  for i in {1..30}; do curl -s -o /dev/null "$URL" && break; sleep 0.2; done
fi
if [ -d "/Applications/Nightshift.app" ]; then open -a "Nightshift"; else open -na "Google Chrome" --args --app="$URL" --window-size=1500,950; fi
